# 应用配置
APP_NAME="SpeedInspect Backend"
DEBUG=true
ENVIRONMENT="development" # development/staging/production
HOST="0.0.0.0"
PORT=8000
WORKERS=4
SECRET_KEY="your-secret-key-here-at-least-32-characters-long"

# 数据库配置
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/speedinspect"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis配置
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=100

# JWT配置
JWT_SECRET="your-jwt-secret-key-here-at-least-32-characters-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS配置
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_ALLOW_CREDENTIALS=true

# 对象存储配置
STORAGE_TYPE="local" # local/s3/oss
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="speedinspect"
STORAGE_REGION="us-east-1"

# LLM配置
LLM_PROVIDER="tongyi" # tongyi/ernie/openai
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="qwen-vl-max"

# 短信配置
SMS_PROVIDER="aliyun" # aliyun/tencent
SMS_ACCESS_KEY="your-sms-access-key"
SMS_SECRET_KEY="your-sms-secret-key"
SMS_SIGN_NAME="SpeedInspect"
SMS_TEMPLATE_CODE="SMS_123456789"

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"

# 日志配置
LOG_LEVEL="INFO"
LOG_FORMAT="json" # json/console
