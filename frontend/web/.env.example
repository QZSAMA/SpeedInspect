# All NEXT_PUBLIC_* values are included in the browser bundle. Do not put
# database credentials, JWTs, encryption keys, Blob tokens, or AI keys here.

# Only for local development against the legacy FastAPI service.
# Leave empty for the same-origin Next.js API. During local FastAPI migration,
# set this to http://localhost:8000/api/v1 in an untracked .env.local file.
NEXT_PUBLIC_API_URL=

# Development demo only. Preview and production must keep this false.
NEXT_PUBLIC_MOCK_CAMERA=false
